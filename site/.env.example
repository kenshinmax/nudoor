# Copy to .env.local and fill in. Every integration is optional in development:
# without keys the site still runs, the brief form succeeds without sending,
# and "Buy" on the Health Check goes to /health-check/unavailable.

# Public site URL, used for canonical links, sitemap, and Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=https://www.nudoor.biz

# Stripe (use test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID for the $495 Payments Health Check (one-time price)
STRIPE_PRICE_HEALTH_CHECK=
# Optional fallback when the API key or price isn't set
STRIPE_PAYMENT_LINK_HEALTH_CHECK=
STRIPE_TAX_ENABLED=false

# Email via Resend
RESEND_API_KEY=
EMAIL_FROM="Nudoor Payments <hello@nudoor.biz>"
TEAM_EMAIL=

# HubSpot private app token (needs contact read/write). Create the custom contact
# properties brightline_source and brightline_interests first.
HUBSPOT_TOKEN=

# Cloudflare Turnstile spam protection for the brief form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Booking link embedded on /contact, e.g. https://cal.com/nudoor/intro
NEXT_PUBLIC_CAL_LINK=

# Plausible analytics domain, e.g. nudoor.example
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Set to true in production so a missing key fails fast at startup instead of degrading quietly.
REQUIRE_INTEGRATIONS=false
